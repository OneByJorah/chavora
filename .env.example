# ─────────────────────────────────────────────────────────────
# chavora — Cloudflare Workers Environment Variables
# Copy to .env before deploying. No runtime secrets are required
# for local `wrangler dev` because the Workers AI binding is configured
# in wrangler.jsonc.
# ─────────────────────────────────────────────────────────────

# Cloudflare API credentials (required only for deployment)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: Custom worker name (defaults to "chavora" from wrangler.jsonc)
# WORKER_NAME=chavora
